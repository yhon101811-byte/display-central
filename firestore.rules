rules_version = '2';
// Solo quien entre con la clave del equipo puede leer o escribir datos.
// Copia este texto en Firebase > Firestore Database > Reglas, con el correo del equipo.
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null
        && request.auth.token.email == 'equipo@display-central-d2686.firebaseapp.com';
    }
    match /{coleccion}/{doc} {
      allow read, write: if autorizado()
        && coleccion in ['clientes', 'proyectos', 'proveedores', 'cotizaciones', 'gastos'];
    }
  }
}
