rules_version = '2';
// Solo los correos de esta lista pueden leer o escribir datos.
// Copia este texto en Firebase > Firestore Database > Reglas y pon los dos correos reales.
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null
        && request.auth.token.email in [
          'CORREO_DE_STEVEN',
          'CORREO_DE_VANESSA'
        ];
    }
    match /{coleccion}/{doc} {
      allow read, write: if autorizado()
        && coleccion in ['clientes', 'proyectos', 'proveedores', 'cotizaciones', 'gastos'];
    }
  }
}
